{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/produk/:id([0-9a-fA-F-]{8,40})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|skypeuripreview|googlebot|google-inspectiontool|bingbot|duckduckbot|yandex|baiduspider|applebot|petalbot).*"
        }
      ],
      "destination": "/api/seo-produk?id=:id"
    },
    {
      "source": "/toko/:id([0-9a-fA-F-]{8,40})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|skypeuripreview|googlebot|google-inspectiontool|bingbot|duckduckbot|yandex|baiduspider|applebot|petalbot).*"
        }
      ],
      "destination": "/api/seo-toko?id=:id"
    },
    {
      "source": "/toko",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|skypeuripreview|googlebot|google-inspectiontool|bingbot|duckduckbot|yandex|baiduspider|applebot|petalbot).*"
        }
      ],
      "destination": "/api/seo-daftar-toko"
    },
    {
      "source": "/produk",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|skypeuripreview|googlebot|google-inspectiontool|bingbot|duckduckbot|yandex|baiduspider|applebot|petalbot).*"
        }
      ],
      "destination": "/api/seo-katalog"
    },
    {
      "source": "/kategori/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|skypeuripreview|googlebot|google-inspectiontool|bingbot|duckduckbot|yandex|baiduspider|applebot|petalbot).*"
        }
      ],
      "destination": "/api/seo-katalog?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
